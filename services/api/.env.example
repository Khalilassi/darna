# Copy to .env for local overrides. Never commit real secrets.
DARNA_ENV=development
DARNA_DATABASE_URL=postgresql+psycopg://postgres@localhost:5432/darna
# Required outside development (the app refuses to start with dev defaults in staging/production):
# DARNA_JWT_SECRET=<64+ random chars>
# DARNA_DOCUMENT_ENCRYPTION_KEY=<output of: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
DARNA_PUBLIC_BASE_URL=http://localhost:8000

# Storage: "local" (default, encrypted files under ./storage) or "s3" (AWS S3 or S3-compatible).
# DARNA_STORAGE_BACKEND=s3
# DARNA_S3_PRIVATE_BUCKET=darna-documents        # block all public access; documents are app-encrypted + SSE
# DARNA_S3_PUBLIC_BUCKET=darna-media             # listing photos only
# DARNA_MEDIA_BASE_URL=https://cdn.example.com   # CDN or public bucket URL serving DARNA_S3_PUBLIC_BUCKET
# DARNA_S3_REGION=eu-central-1
# DARNA_S3_KMS_KEY_ID=<kms key id/arn>           # optional: SSE-KMS instead of SSE-S3
# DARNA_S3_ENDPOINT_URL=https://<minio-or-r2>    # optional: S3-compatible stores
# AWS credentials come from the standard chain (env vars or an instance/task role), never from this file.
